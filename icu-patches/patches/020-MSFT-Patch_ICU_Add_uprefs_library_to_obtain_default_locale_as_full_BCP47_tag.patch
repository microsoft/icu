+void UPrefsTest::Get24HourCycleMixed() 
+{
+    char languageBuffer[ARRAY_SIZE] = {0};
+    language = L"ja-JP";
+    currency = L"MXN";
+    hourCycle = L"HHhh:mm:ss";
+    firstday = 1;
+    measureSystem = 0;
+    calendar = CAL_THAI;
+    UErrorCode status = U_ZERO_ERROR;
+    char* expectedValue = "ja-JP-u-ca-buddhist-cu-mxn-fw-tue-hc-h23-ms-metric";
