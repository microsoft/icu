--- a/icu/icu4c/source/data/rbnf/zh_Hant_HK.txt
+++ b/icu/icu4c/source/data/rbnf/zh_Hant_HK.txt
@@ -2,5 +2,4 @@
 // License & terms of use: http://www.unicode.org/copyright.html
 // Generated using tools/cldr/cldr-to-icu/
 zh_Hant_HK{
-    "%%ALIAS"{"yue"}
 }
