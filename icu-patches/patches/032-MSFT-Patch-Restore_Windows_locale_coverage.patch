+static UBool isLocaleOrChildInList(const char *locale, const char *const *parents, int32_t count) {
+    int32_t i;
+    for (i = 0; i < count; ++i) {
+        size_t length = uprv_strlen(parents[i]);
+        if (uprv_strncmp(locale, parents[i], length) == 0 &&
+                (locale[length] == 0 || locale[length] == '_')) {
+            return true;
+        }
+    }
+    return false;
+}
